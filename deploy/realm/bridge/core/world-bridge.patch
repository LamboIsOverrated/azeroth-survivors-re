+// Ownership transfers only when the existing single-writer FIFO accepts the job.
+bool Database::QueueWorldBridge(SqlOperation* operation)
+{
+    if (!operation || !m_allowAsyncTransactions || !m_threadBody || m_currentTransaction.get()) return false;
+    return m_threadBody->Delay(operation);
+}
+bool Database::HasQueuedExecutionFailure() const
+{
+    return !m_threadBody || m_threadBody->HasExecutionFailure();
+}
