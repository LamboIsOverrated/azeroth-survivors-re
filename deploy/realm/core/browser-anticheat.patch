+void Movement::ResetBrowserMovement(Position const& pos)
+{
+    const uint32 now = WorldTimer::getMSTime();
+    _browserKnockback.End();
+    _inKnockBack = false;
+    _me->SetLaunched(false);
+    const double speed = std::max<double>(_me->GetSpeed(MOVE_RUN),
+        std::max(_me->GetSpeed(MOVE_SWIM), _me->GetSpeed(MOVE_WALK)));
+    _browserBudget.Reset(now, speed);
+    float x = pos.x, y = pos.y, z = pos.z;
+    if (GenericTransport* transport = _me->GetTransport())
+    {
+        transport->CalculatePassengerOffset(x, y, z);
+        _browserFrame = transport->GetObjectGuid();
+    }
+    else
+        _browserFrame = ObjectGuid();
+    _browserAir.Reset(now, z);
+    _browserLastAirZ = z;
+    _browserHasFrame = true;
+    _browserSlowFall = _me->HasAuraType(SPELL_AURA_FEATHER_FALL);
+}
+
+void Movement::HandleTeleport(const Position &pos)
+{
+    // The callback receives the server destination after its teleport ACK.
+    ResetBrowserMovement(pos);
+    _justTeleported = true; // Stock diagnostics only; never a packet exemption.
+}
+
+void Movement::ExpireBrowserKnockback()
+{
+    if (_browserKnockback.Expired(WorldTimer::getMSTime()))
+        ResetBrowserMovement({_me->GetPositionX(), _me->GetPositionY(), _me->GetPositionZ(), _me->GetOrientation()});
 }
 
