+void Movement::ResetBrowserMovement()
+{
+    const uint32 now = WorldTimer::getMSTime();
+    _browserKnockback.End();
+    _browserKnockbackReceipt.Clear();
+    _browserKnockbackAckStaged = false;
+    _inKnockBack = false;
+    _me->SetLaunched(false);
+    const double speed = std::max<double>(_me->GetSpeed(MOVE_RUN),
+        std::max(_me->GetSpeed(MOVE_SWIM), _me->GetSpeed(MOVE_WALK)));
+    _browserBudget.Reset(now, speed);
+    float x = _me->GetPositionX(), y = _me->GetPositionY(), z = _me->GetPositionZ();
+    if (GenericTransport* transport = _me->GetTransport())
+    {
+        transport->CalculatePassengerOffset(x, y, z);
+        _browserFrame = transport->GetObjectGuid();
+    }
+    else
+        _browserFrame = ObjectGuid();
+    _browserAir.Reset(now, z);
+    _browserLastAirZ = z;
+    _browserHasFrame = true;
+    _browserSlowFall = _me->HasAuraType(SPELL_AURA_FEATHER_FALL);
