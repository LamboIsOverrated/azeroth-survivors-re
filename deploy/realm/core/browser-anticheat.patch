+bool Movement::CheckBrowserMovement(MovementInfo& mi, uint16 opcode)
+{
+    if (_me->GetSession()->GetSecurity() != SEC_PLAYER || !_me->IsSelfMover())
+        return true;
+
+    ExpireBrowserKnockback(); // Server clock, independent of LAND/SWIM or any packet time.
+    auto reject = [this](char const* reason)
+    {
+        _anticheat->RecordCheatInternal(CHEAT_TYPE_TELEPORT, "Browser movement rejected: %s", reason);
+        return false;
+    };
+    if (!std::isfinite(mi.pos.x) || !std::isfinite(mi.pos.y) || !std::isfinite(mi.pos.z))
+        return reject("nonfinite-position");
+
+    const uint32 now = WorldTimer::getMSTime();
+    const double speed = _me->hasUnitState(UNIT_STAT_STUNNED | UNIT_STAT_ROOT) ? 0.0 : std::max<double>(
+        _me->GetSpeed(MOVE_RUN), std::max(_me->GetSpeed(MOVE_SWIM), _me->GetSpeed(MOVE_WALK)));
+    auto budget = _browserBudget;
+    auto air = _browserAir;
+    auto knock = _browserKnockback;
+    const bool reconcile = opcode == CMSG_MOVE_KNOCK_BACK_ACK && _browserKnockbackAckStaged;
+    _browserKnockbackAckStaged = false; // A failed ACK cannot stage the next ordinary packet.
+    const bool forced = knock.Active() && !_browserKnockbackReceipt.Pending();
+    double distance = std::hypot(double(mi.pos.x) - _me->GetPositionX(),
+                                 double(mi.pos.y) - _me->GetPositionY());
+    double airZ = mi.pos.z, previousAirZ = _me->GetPositionZ();
+    GenericTransport* activeTransport = _me->GetTransport();
+    GenericTransport* requestedTransport = nullptr;
+    if (mi.HasMovementFlag(MOVEFLAG_ONTRANSPORT))
+    {
+        requestedTransport = _me->GetMap()->GetTransport(mi.GetTransportGuid());
+        if (!requestedTransport || (activeTransport && activeTransport != requestedTransport))
+            return reject("unknown-or-switched-transport");
+        if (activeTransport && !activeTransport->GetPassengers().count(_me))
+            return reject("unowned-transport-membership");
+        float x = mi.GetTransportPos().x, y = mi.GetTransportPos().y, z = mi.GetTransportPos().z;
+        requestedTransport->CalculatePassengerPosition(x, y, z);
+        if (!RealmBrowser::TransportCoordinatesValid(mi.GetTransportPos().x, mi.GetTransportPos().y,
+                mi.GetTransportPos().z, double(x) - mi.pos.x, double(y) - mi.pos.y, double(z) - mi.pos.z))
+            return reject("invalid-transport-transform");
+        if (!activeTransport && !requestedTransport->IsWithinDist(_me, 70.f, true))
+            return reject("remote-transport-boarding");
+        if (activeTransport)
+            distance = std::hypot(double(mi.GetTransportPos().x) - _me->GetTransOffsetX(),
+                                   double(mi.GetTransportPos().y) - _me->GetTransOffsetY());
+        else
+            distance = std::hypot(double(x) - _me->GetPositionX(), double(y) - _me->GetPositionY());
+        float oldX = _me->GetPositionX(), oldY = _me->GetPositionY(), oldZ = _me->GetPositionZ();
+        requestedTransport->CalculatePassengerOffset(oldX, oldY, oldZ);
+        airZ = mi.GetTransportPos().z;
+        previousAirZ = activeTransport ? _me->GetTransOffsetZ() : oldZ;
+        mi.pos.x = x; mi.pos.y = y; mi.pos.z = z;
+    }
+    const ObjectGuid nextFrame = requestedTransport ? requestedTransport->GetObjectGuid() : ObjectGuid();
+    if (_browserHasFrame && nextFrame != _browserFrame && !air.Rebase(previousAirZ - _browserLastAirZ))
+        return reject("invalid-air-coordinate-frame");
+    if (mi.moveFlags & (MOVEFLAG_FLYING | MOVEFLAG_CAN_FLY | MOVEFLAG_LEVITATING))
+        return reject("unauthorized-flight-flags");
+    if (!budget.Accept(now, distance, forced ? std::max(speed, knock.HorizontalSpeed()) : speed))
+        return reject("server-time-distance-budget");
+
+    uint32 removeFlags = 0;
+    VerifyMovementFlags(mi.moveFlags, removeFlags, true);
+    if (removeFlags)
+        return reject("unauthorized-movement-flags");
+    if (!_me->GetMap()->IsInLineOfSight(_me->GetPositionX(), _me->GetPositionY(),
+            _me->GetPositionZ() + 0.5f, mi.pos.x, mi.pos.y, mi.pos.z + 0.5f, false))
+        return reject("movement-through-map-collision");
+
+    float floor = _me->GetMap()->GetHeight(mi.pos.x, mi.pos.y, mi.pos.z);
+    const auto liquid = _me->GetTerrain()->getLiquidStatus(mi.pos.x, mi.pos.y, mi.pos.z, MAP_ALL_LIQUIDS, nullptr);
+    const bool water = !!(liquid & (LIQUID_MAP_IN_WATER | LIQUID_MAP_UNDER_WATER));
+    if (_me->HasAuraType(SPELL_AURA_WATER_WALK) || _me->HasAuraType(SPELL_AURA_GHOST))
+        floor = std::max(floor, _me->GetTerrain()->GetWaterLevel(mi.pos.x, mi.pos.y, mi.pos.z));
+    const bool surface = water || (std::isfinite(floor) && floor > -50000.f &&
+                                  std::fabs(mi.pos.z - floor) <= 1.5f);
+    if (!water && std::isfinite(floor) && floor > -50000.f && mi.pos.z < floor - 2.f)
+        return reject("below-map-surface");
+    if (requestedTransport && !activeTransport && !surface)
+        return reject("transport-boarding-not-on-surface");
+    const bool slowFall = _me->HasAuraType(SPELL_AURA_FEATHER_FALL);
+    if (forced)
+    {
+        bool collisionStopped = false;
+        if (surface)
+        {
+            const auto origin = knock.Origin();
+            const auto predicted = knock.Predicted(now, slowFall);
+            if (MaNGOS::IsValidMapCoord(float(predicted.x), float(predicted.y), float(predicted.z), 0.f))
+            {
+                float x = float(predicted.x), y = float(predicted.y), z = float(predicted.z) + 0.5f;
+                if (_me->GetMap()->GetHitPosition(float(origin.x), float(origin.y), float(origin.z) + 0.5f,
+                                                x, y, z, 0.f))
+                {
+                    z -= 0.5f;
+                    collisionStopped = std::pow(double(mi.pos.x) - x, 2) + std::pow(double(mi.pos.y) - y, 2) +
+                                       std::pow(double(mi.pos.z) - z, 2) <= 4.0;
+                }
+            }
+        }
+        if (!knock.Check(now, {mi.pos.x, mi.pos.y, mi.pos.z}, surface, slowFall, collisionStopped))
+            return reject("server-knockback-trajectory");
+        if (!knock.Active())
+        {
+            budget.Reset(now, speed);
+            air.Reset(now, airZ);
+        }
+    }
+    else
+    {
+        if (slowFall != _browserSlowFall)
+            air.Reset(now, previousAirZ); // Server aura change, never the submitted Z.
+        if (!air.Accept(now, airZ, previousAirZ, surface,
+                [slowFall](double seconds) { return RealmBrowser::FallElevation(seconds, slowFall); }))
+            return reject("airborne-gravity-envelope");
+    }
+    if (reconcile)
+    {
+        // The first ACK is ordinary movement until this entire geometry/policy
+        // path accepts it. Rebase only to that budgeted, map-verified origin.
+        // Trajectory T0 follows validated application/ACK time, while the original
+        // server issue clock still caps the absolute launch lifetime.
+        if (!knock.RebaseAtReceipt(now, {mi.pos.x, mi.pos.y, mi.pos.z}) ||
+            !_browserKnockbackReceipt.Consume(now, _browserKnockbackCounter, mi.moveFlags,
+                mi.jump.cosAngle, mi.jump.sinAngle, mi.jump.xyspeed, mi.jump.zspeed))
+            return reject("invalid-knockback-receipt-commit");
+    }
+    _browserBudget = budget;
+    _browserAir = air;
+    _browserKnockback = knock;
+    _browserFrame = nextFrame;
+    _browserLastAirZ = airZ;
+    _browserHasFrame = true;
+    _browserSlowFall = slowFall;
+    if (forced && !knock.Active())
+    {
+        _inKnockBack = false;
+        _me->SetLaunched(false); // Map/trajectory verified landing, no client opcode required.
+    }
+    return true;
 }
 
